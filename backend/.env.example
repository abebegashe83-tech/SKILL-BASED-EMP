DEBUG=True
SECRET_KEY=replace-this-with-a-very-secret-production-key
DATABASE_URL=postgres://user:password@localhost:5432/employment_db

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

AI_SERVICE_URL=http://localhost:8001/api/v1

# Hugging Face Token (Optional - for faster model downloads)
HF_TOKEN=your-huggingface-token

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=noreply@skillmatch.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password

# SMS Configuration (Optional - for password reset via SMS)
SMS_PROVIDER=twilio  # Options: twilio, custom_api, or leave empty for development mode
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+251903133507  # Your Twilio phone number

# For custom SMS API (if SMS_PROVIDER=custom_api)
SMS_API_KEY=your-api-key
SMS_API_URL=https://your-sms-api.com/send

